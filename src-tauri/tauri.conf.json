{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oneView",
  "mainBinaryName": "oneView",
  "version": "0.21.10",
  "identifier": "com.xiaomogu.markdownviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "oneView",
        "width": 860,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost asset: https: http:; worker-src 'self' blob:; child-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "publisher": "小蘑菇",
    "copyright": "Copyright © 2026 小蘑菇",
    "shortDescription": "轻量、快速、本地优先的多格式文件查看器",
    "longDescription": "oneView 是一个基于 Tauri 2 的轻量多格式文件查看器：主程序内置 Markdown 富渲染、所见即所得编辑、文件监听、文件夹工作区和插件系统；JSON、YAML、CSV、TOML、LOG、DIFF/PATCH 等开发文档通过可选插件提供。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
